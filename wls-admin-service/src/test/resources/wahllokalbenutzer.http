### get userinfo with auth_token
# @no-redirect
GET {{ WLS_AUTH_SERVICE }}/user
Authorization: Bearer {{$auth.token("auth-service")}}

// !! OVERRIDES user wls_all_uwb
### Generate Wahllokalbenutzer (needs profile 'dummy.clients' to make this work because of internal calls to other services) | user wls_all_uwb
POST {{ WLS_ADMIN_SERVICE_URL }}/businessActions/generateWahllokalbenutzer/827e9e6a-ebe9-483f-a9cd-162b26f348e8
Authorization: Bearer {{$auth.token("auth-service")}}
Content-Type: application/json

### Export Wahllokalbenutzer (needs profile 'dummy.clients' to make this work because of internal calls to other services) | user wls_all_uwb
GET {{ WLS_ADMIN_SERVICE_URL }}/businessActions/exportWahllokalBenutzer/827e9e6a-ebe9-483f-a9cd-162b26f348e8
Authorization: Bearer {{$auth.token("auth-service")}}
Content-Type: application/json

### Delete Wahllokalbenutzer (needs profile 'dummy.clients' to make this work because of internal calls to other services) | user wls_all_uwb
