### Get token wls_all
POST {{ SSO_URL }}/auth/realms/wls_realm/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

password = test &
grant_type = password &
client_secret = top-secret &
client_id = wls &
username = wls_all

> {%
    client.global.set("auth_token", response.body.access_token);
    client.global.set("token_type", response.body.token_type);
%}

### get userinfo with auth_token
GET {{ SSO_URL }}/auth/realms/wls_realm/protocol/openid-connect/userinfo
Authorization: {{ token_type }} {{ auth_token }}

### create Users wahltagID1
POST {{ WLS_AUTH_SERVICE }}/generateAndExportWahllokalbenutzer/wahltagID1
Authorization: {{ token_type }} {{ auth_token }}
Content-Type: application/json

[
  {
    "wahlbezirknummer": "1001",
    "wahltag": "2024-10-29",
    "wahlbezirkID": "wbzID-1",
    "wahlbezirksart": "UWB",
    "wbid_wahlnummer": "0"
  },
  {
    "wahlbezirknummer": "1002",
    "wahltag": "2024-10-29",
    "wahlbezirkID": "wbzID-2",
    "wahlbezirksart": "UWB",
    "wbid_wahlnummer": "0"
  },
  {
    "wahlbezirknummer": "1003",
    "wahltag": "2024-10-29",
    "wahlbezirkID": "wbzID-3",
    "wahlbezirksart": "UWB",
    "wbid_wahlnummer": "0"
  }
]

### get users of wahltagID1
GET {{ WLS_AUTH_SERVICE }}/exportWahllokalbenutzer/wahltagID1
Authorization: {{ token_type }} {{ auth_token }}

### delete users of wahltagID1
DELETE {{ WLS_AUTH_SERVICE }}/deleteWahllokalbenutzer/wahltagID1
Authorization: {{ token_type }} {{ auth_token }}