### get userinfo with auth_token
GET {{ WLS_AUTH_SERVICE }}/user
Authorization: Bearer {{$auth.token("auth-service")}}

### POST Handbuch | user wls_all_uwb
POST {{ WLS_BASISDATEN_SERVICE_URL }}/businessActions/handbuch/827e9e6a-ebe9-483f-a9cd-162b26f348e8/UWB
Authorization: Bearer {{$auth.token("auth-service")}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="helloWorld.pdf"

< ./attachements/helloWorld.pdf
--boundary

