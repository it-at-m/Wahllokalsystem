### get userinfo with auth_token
GET {{ WLS_AUTH_SERVICE }}/user
Authorization: Bearer {{$auth.token("auth-service")}}

### POST Wahlen
## Hier wird das Datum des Wahltages mit der wahltagID1 gesetzt (today - 2 months) - siehe DummyClient
< {%
    const wahltag = new Date();
    wahltag.setMonth(wahltag.getMonth() - 2);
    const wahltagAsDateString = wahltag.toJSON().substring(0, 10);
    request.variables.set("dateOfWahltagID1", wahltagAsDateString);
%}
POST {{ WLS_BASISDATEN_SERVICE_URL }}/businessActions/wahlen/wahltagID1
Authorization: Bearer {{$auth.token("auth-service")}}
Content-Type: application/json

[
  {
    "wahlID": "wahl1",
    "name": "aName_1",
    "reihenfolge": 1,
    "waehlerverzeichnisnummer": 1,
    "wahltag": "{{ dateOfWahltagID1 }}",
    "wahlart": "BTW",
    "farbe": {
      "r": 0,
      "g": 1,
      "b": 2
    },
    "nummer": "1"
  },
  {
    "wahlID": "wahl2",
    "name": "1",
    "reihenfolge": 2,
    "waehlerverzeichnisnummer": 1,
    "wahltag": "{{ dateOfWahltagID1 }}",
    "wahlart": "EUW",
    "farbe": {
      "r": 3,
      "g": 4,
      "b": 5
    },
    "nummer": "1"
  },
  {
    "wahlID": "wahl3",
    "name": "2-",
    "reihenfolge": 3,
    "waehlerverzeichnisnummer": 1,
    "wahltag": "{{ dateOfWahltagID1 }}",
    "wahlart": "LTW",
    "farbe": {
      "r": 6,
      "g": 7,
      "b": 8
    },
    "nummer": "1"
  }
]

### GET Wahlen
GET {{ WLS_BASISDATEN_SERVICE_URL }}/businessActions/wahlen/wahltagID1
Authorization: Bearer {{$auth.token("auth-service")}}