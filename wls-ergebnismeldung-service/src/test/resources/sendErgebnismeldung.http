### Initialisiere A-Werte (needs profile 'dummy.clients', stores AWerte entity in local DB retrieved from DummyClient )
POST {{ WLS_ERGEBNISMELDUNG_SERVICE_URL }}/businessActions/awerte/init
Authorization: Bearer {{$auth.token("auth-service")}}
Content-Type: application/json

[
  "wahlbezirkID"
]

### Initialisiere Ergebnisse - Ergebnisse Stapel EUW_A
POST {{ WLS_ERGEBNISMELDUNG_SERVICE_URL }}/businessActions/ergebnisse/wahlbezirkID/wahlID01/EUW_A
Content-Type: application/json
Authorization: Bearer {{$auth.token("auth-service")}}

{
  "bezirkUndWahlIDStapelart": {
    "wahlbezirkID": "wahlbezirkID",
    "wahlID": "wahlID01",
    "stapelart": "EUW_A"
  },
  "ergebnisse": [
    {
      "wahlvorschlagID": "wahlvorschlagID1",
      "kandidatID": "kandidatID1",
      "wahlvorschlagsordnungszahl": 1,
      "ergebnis": 1,
      "numIndex": 1
    },
    {
      "wahlvorschlagID": "wahlvorschlagID2",
      "kandidatID": "kandidatID2",
      "wahlvorschlagsordnungszahl": 2,
      "ergebnis": 2,
      "numIndex": 2
    }
  ]
}

