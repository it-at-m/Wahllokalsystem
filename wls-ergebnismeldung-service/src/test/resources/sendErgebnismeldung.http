### POST stimmabgabevermerke
POST {{ WLS_ERGEBNISMELDUNG_SERVICE_URL }}/businessActions/stimmabgabevermerke/wahlbezirkID/1
Authorization: Bearer {{$auth.token("auth-service")}}
Content-Type: application/json

{
  "wahlbezirkID": "wahlbezirkID",
  "waehlerverzeichnisNummer": 1,
  "anzahlBlaetter": 2,
  "wahldaten": [
    {
      "waehlerverzeichnisNummer": 1,
      "wahlbezirkID": "wahlbezirkID",
      "wahlID": "wahlID01",
      "eingenommenewahlscheine": [
        {
          "anzahl": 2,
          "stimmzettelart": "KLEIN"
        },
        {
          "anzahl": 4,
          "stimmzettelart": "BEIDE"
        },
        {
          "anzahl": 12,
          "stimmzettelart": "GROSS"
        }
      ],
      "vermerke": [
        {
          "blattnummer": 1,
          "stimmzettel": [
            {
              "anzahl": 1,
              "stimmzettelart": "GROSS"
            },
            {
              "anzahl": 1,
              "stimmzettelart": "KLEIN"
            }
          ]
        }
      ]
    }
  ]
}

### Send Ergebnismeldung
POST {{ WLS_ERGEBNISMELDUNG_SERVICE_URL }}/businessActions/sendErgebnismeldung/wahlID01/wahlbezirkID/1/V1/wahlbezirkID
Authorization: Bearer {{$auth.token("auth-service")}}
Content-Type: application/json