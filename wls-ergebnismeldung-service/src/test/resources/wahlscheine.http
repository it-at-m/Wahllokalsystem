### get userinfo with auth_token
GET {{ WLS_AUTH_SERVICE }}/user
Authorization: Bearer {{$auth.token("auth-service")}}

### GET wahlscheine ba wahlID and wahlbezirkID
GET {{ WLS_ERGEBNISMELDUNG_SERVICE_URL }}/businessActions/wahlscheine/wahlID/wahlbezirkID
Authorization: Bearer {{$auth.token("auth-service")}}

### POST wahlscheine - wahlbezirkID
POST {{ WLS_ERGEBNISMELDUNG_SERVICE_URL }}/businessActions/wahlscheine/wahlID/wahlbezirkID
Content-Type: application/json
Authorization: Bearer {{$auth.token("auth-service")}}

{
  "bezirkUndWahlID": {
    "wahlID": "wahlID",
    "wahlbezirkID": "wahlbezirkID"
  },
  "stimmabgabevermerke": 33
}

### POST wahlscheine - wahlbezirkID1
POST {{ WLS_ERGEBNISMELDUNG_SERVICE_URL }}/businessActions/wahlscheine/wahlID/wahlbezirkID1
Content-Type: application/json
Authorization: Bearer {{$auth.token("auth-service")}}

{
  "bezirkUndWahlID": {
    "wahlID": "wahlID",
    "wahlbezirkID": "wahlbezirkID1"
  },
  "stimmabgabevermerke": 33
}