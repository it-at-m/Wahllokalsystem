{
  "name": "wls-gui-admintool",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.14 <=22"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "build": "vue-tsc --build --noCheck && vite build",
    "lint": "prettier . --check && eslint . && vue-tsc --build --noEmit",
    "fix": "prettier . --write && eslint . --fix",
    "gen:admin-api": "openapi-generator-cli generate -i src/resources/openapis/openapi.admin.0.2.0.json -g typescript-axios -o src/api/wls-clients/generated-admin-api",
    "gen:auth-api": "openapi-generator-cli generate -i src/resources/openapis/openapi.auth.0.6.2.json -g typescript-axios -o src/api/wls-clients/generated-auth-api",
    "gen:basisdaten-api": "openapi-generator-cli generate -i src/resources/openapis/openapi.basisdaten.0.2.0.json -g typescript-axios -o src/api/wls-clients/generated-basisdaten-api",
    "gen:broadcast-api": "openapi-generator-cli generate -i src/resources/openapis/openapi.broadcast.0.3.0.json -g typescript-axios -o src/api/wls-clients/generated-broadcast-api",
    "gen:ergebnismeldung-api": "openapi-generator-cli generate -i src/resources/openapis/openapi.ergebnismeldung.0.3.0.json -g typescript-axios -o src/api/wls-clients/generated-ergebnismeldung-api",
    "gen:infomanagement-api": "openapi-generator-cli generate -i src/resources/openapis/openapi.infomanagement.0.3.0.json -g typescript-axios -o src/api/wls-clients/generated-infomanagement-api",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.10",
    "@muenchen/appswitcher-vue": "2.2.0",
    "@vueuse/core": "14.3.0",
    "pinia": "3.0.4",
    "vue": "3.5.30",
    "vue-router": "4.6.4",
    "vue3-toastify": "0.2.9",
    "vuetify": "3.11.9"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "3.2.7",
    "@mdi/js": "7.4.47",
    "@muenchen/prettier-codeformat": "1.0.2",
    "@pinia/testing": "1.0.3",
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/addon-interactions": "8.6.18",
    "@storybook/addon-onboarding": "8.6.18",
    "@storybook/blocks": "8.6.18",
    "@storybook/test": "8.6.18",
    "@storybook/vue3": "8.6.18",
    "@storybook/vue3-vite": "8.6.18",
    "@tsconfig/node-lts": "22.0.4",
    "@types/node": "22.14.1",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.7.0",
    "@vue/test-utils": "2.4.10",
    "@vue/tsconfig": "0.9.1",
    "axios": "1.16.0",
    "eslint": "9.39.4",
    "eslint-plugin-storybook": "0.12.0",
    "eslint-plugin-vue": "9.33.0",
    "jsdom": "26.1.0",
    "msw": "2.14.5",
    "msw-storybook-addon": "2.0.7",
    "prettier": "3.8.3",
    "storybook": "8.6.18",
    "typescript": "5.9.3",
    "unplugin-fonts": "1.4.0",
    "vite": "6.4.2",
    "vite-plugin-vue-devtools": "7.7.9",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "3.2.4",
    "vue-tsc": "2.2.12"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "msw": {
    "workerDirectory": [
      ".msw/public"
    ]
  },
  "overrides": {
    "@storybook/vue3": {
      "vue-component-type-helpers": "3.2.8"
    }
  }
}
