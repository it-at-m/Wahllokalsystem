{
  "name": "wls-gui-wahllokalsystem",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20 <=22"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "build": "vue-tsc --build --force && vite build",
    "preview": "vite preview",
    "build-preview": "npm run build && npm run preview",
    "lint": "prettier . --check && eslint . && vue-tsc --noEmit",
    "fix": "prettier . --write && eslint . --fix",
    "gen:broadcast-api": "openapi-generator-cli generate -i src/resources/openapis/openapi.broadcast.0.2.0.json -g typescript-axios -o src/api/wls-clients/generated-broadcast-api",
    "gen:wahlvorstand-api": "openapi-generator-cli generate -i src/resources/openapis/openapi.wahlvorstand.0.2.0.json -g typescript-axios -o src/api/wls-clients/generated-wahlvorstand-api",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@vueuse/core": "12.4.0",
    "localforage": "1.10.0",
    "pinia": "2.3.0",
    "roboto-fontface": "0.10.0",
    "vue": "3.5.13",
    "vue-router": "4.5.0",
    "vuetify": "3.7.6"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "3.2.4",
    "@mdi/js": "7.4.47",
    "@muenchen/prettier-codeformat": "1.0.2",
    "@pinia/testing": "0.1.7",
    "@storybook/addon-essentials": "8.5.6",
    "@storybook/addon-interactions": "8.5.6",
    "@storybook/addon-onboarding": "8.5.6",
    "@storybook/blocks": "8.5.6",
    "@storybook/test": "8.5.6",
    "@storybook/vue3": "8.5.6",
    "@storybook/vue3-vite": "8.5.6",
    "@tsconfig/node-lts": "22.0.1",
    "@types/node": "22.13.9",
    "@vitejs/plugin-vue": "5.1.4",
    "@vue/eslint-config-prettier": "10.1.0",
    "@vue/eslint-config-typescript": "14.1.4",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.5.1",
    "axios": "1.7.9",
    "eslint": "9.14.0",
    "eslint-plugin-storybook": "0.11.3",
    "eslint-plugin-vue": "9.31.0",
    "jsdom": "25.0.1",
    "prettier": "3.3.3",
    "storybook": "8.5.6",
    "typescript": "5.5.4",
    "unplugin-fonts": "1.1.1",
    "vite": "5.4.12",
    "vite-plugin-pwa": "0.21.1",
    "vite-plugin-vuetify": "2.0.4",
    "vitest": "2.1.9",
    "vue-tsc": "2.2.0",
    "workbox-core": "7.3.0",
    "workbox-precaching": "7.3.0",
    "workbox-routing": "7.3.0"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
