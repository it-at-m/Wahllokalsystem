{
  "name": "wls-gui-wahllokalsystem",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.14 <=22"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "build": "vue-tsc --build --force && vite build",
    "build-in-dev-mode": "vue-tsc --build --force && vite build --mode dev",
    "preview": "vite preview",
    "build-preview": "npm run build-in-dev-mode && npm run preview",
    "lint": "prettier . --check && eslint . && vue-tsc --noEmit",
    "fix": "prettier . --write && eslint . --fix",
    "gen:auth-api": "openapi-generator-cli generate -i src/resources/openapis/openapi.auth.0.6.2.json -g typescript-axios -o src/api/wls-clients/generated-auth-api",
    "gen:basisdaten-api": "openapi-generator-cli generate -i src/resources/openapis/openapi.basisdaten.0.2.0.json -g typescript-axios -o src/api/wls-clients/generated-basisdaten-api",
    "gen:briefwahl-api": "openapi-generator-cli generate -i src/resources/openapis/openapi.briefwahl.0.2.0.json -g typescript-axios -o src/api/wls-clients/generated-briefwahl-api",
    "gen:broadcast-api": "openapi-generator-cli generate -i src/resources/openapis/openapi.broadcast.0.3.0.json -g typescript-axios -o src/api/wls-clients/generated-broadcast-api",
    "gen:ergebnismeldung-api": "openapi-generator-cli generate -i src/resources/openapis/openapi.ergebnismeldung.0.3.0.json -g typescript-axios -o src/api/wls-clients/generated-ergebnismeldung-api --type-mappings=set=Array",
    "gen:infomanagement-api": "openapi-generator-cli generate -i src/resources/openapis/openapi.infomanagement.0.4.1.json -g typescript-axios -o src/api/wls-clients/generated-infomanagement-api",
    "gen:monitoring-api": "openapi-generator-cli generate -i src/resources/openapis/openapi.monitoring.0.2.0.json -g typescript-axios -o src/api/wls-clients/generated-monitoring-api",
    "gen:vorfaelleundvorkommnisse-api": "openapi-generator-cli generate -i src/resources/openapis/openapi.vorfaelleundvorkommnisse.0.2.0.json -g typescript-axios -o src/api/wls-clients/generated-vorfaelleundvorkommnisse-api",
    "gen:wahlvorbereitung-api": "openapi-generator-cli generate -i src/resources/openapis/openapi.wahlvorbereitung.0.2.0.json -g typescript-axios -o src/api/wls-clients/generated-wahlvorbereitung-api",
    "gen:wahlvorstand-api": "openapi-generator-cli generate -i src/resources/openapis/openapi.wahlvorstand.0.3.0.json -g typescript-axios -o src/api/wls-clients/generated-wahlvorstand-api",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@vueuse/core": "14.0.0",
    "localforage": "1.10.0",
    "pinia": "3.0.3",
    "@fontsource/roboto": "5.2.6",
    "vue": "3.5.22",
    "vue-router": "4.6.3",
    "vue3-toastify": "0.2.8",
    "vuetify": "3.10.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "3.2.7",
    "@mdi/js": "7.4.47",
    "@muenchen/prettier-codeformat": "1.0.2",
    "@pinia/testing": "1.0.2",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/addon-onboarding": "8.6.14",
    "@storybook/blocks": "8.6.14",
    "@storybook/test": "8.6.14",
    "@storybook/vue3": "8.6.14",
    "@storybook/vue3-vite": "8.6.14",
    "@tsconfig/node-lts": "22.0.2",
    "@types/node": "22.14.1",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.6.0",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.8.1",
    "axios": "1.12.2",
    "eslint": "9.35.0",
    "eslint-plugin-storybook": "0.12.0",
    "eslint-plugin-vue": "9.33.0",
    "jsdom": "26.1.0",
    "msw": "2.11.6",
    "msw-storybook-addon": "2.0.6",
    "prettier": "3.6.2",
    "sass": "1.92.1",
    "storybook": "8.6.14",
    "typescript": "5.9.2",
    "unplugin-fonts": "1.4.0",
    "vite": "6.4.1",
    "vite-plugin-pwa": "0.21.2",
    "vite-plugin-vuetify": "2.1.2",
    "vitest": "3.2.4",
    "vue-tsc": "2.2.12",
    "workbox-core": "7.3.0",
    "workbox-precaching": "7.3.0",
    "workbox-routing": "7.3.0"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "msw": {
    "workerDirectory": [
      ".msw/public"
    ]
  }
}
