{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "declarations.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "tests/**/*.ts",
    "stories/**/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./cache/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023"],
    "paths": {
      "@/*": ["./src/*"],
      "@tests/*": ["./tests/*"]
    },
    "allowSyntheticDefaultImports": true
  }
}
