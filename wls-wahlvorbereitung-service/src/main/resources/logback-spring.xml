<?xml version="1.0" encoding="UTF-8"?>

<!-- The possibly existing properties concerning the "logging.level" in the application.yml
     have priority over the log level maintained in this file.  -->
<configuration>


    <springProperty scope="context" name="springAppName" source="spring.application.name"/>


    <springProfile name="plainTextLogging">

        <!-- Log appender -->
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
                <pattern>
                    %date{yyyy.MM.dd HH:mm:ss.SSS} | ${springAppName} | user: %X{user} | TraceId: %X{traceId:-} | SpanId: %X{spanId:-}] | %level | [%thread] | %logger{0} | [%file : %line] - %msg%n
                </pattern>
            </encoder>
        </appender>

        <!-- Logger: only set levels; appenders are configured on the root logger -->
        <logger name="de.muenchen.oss.wahllokalsystem.wahlvorbereitungservice" level="debug" />
        <logger name="de.muenchen.allgemein" level="debug" />
        <logger name="org.springframework.cache" level="trace" />
        <logger name="org.springframework.web" level="debug" />
        <!-- use debug to see the users authorities -->
        <logger name="de.muenchen.oss.wahllokalsystem.wahlvorbereitungservice.configuration.UserInfoAuthoritiesRetriever" level="debug" />
        <!-- use debug to see how headers and payload are nfc handled -->
        <logger name="de.muenchen.oss.wahllokalsystem.wahlvorbereitungservice.configuration.nfcconverter" level="debug" />
        <!-- use debug to see sql queries logged -->
        <logger name="org.hibernate.SQL" level="debug" />
        <!-- requires spring.jpa.properties.hibernate.generate_statistics=true -->
        <logger name="org.hibernate.engine.internal.StatisticalLoggingSessionEventListener" level="debug" />

        <!-- PathVars, URL & Parameter -->
        <logger name="org.springframework.web.servlet.DispatcherServlet" level="debug" />
        <!-- Methodennamen -->
        <logger name="org.springframework.web.servlet.mvc.method.annotation.RequestMappingHandlerMapping" level="debug" />
        <!-- User, URL, Status -->
        <logger name="de.muenchen.oss.wahllokalsystem.wahlvorbereitungservice.security.RequestResponseLoggingFilter" level="debug" />
        <!-- Specific NfcHelper Filter for Payload (specific loglevel can be set) -->
        <logger name="de.muenchen.oss.wahllokalsystem.wahlvorbereitungservice.configuration.nfcconverter.NfcHelper" level="debug" />
        <!-- Logger for other Nfc Logging-Data -->
        <logger name="de.muenchen.oss.wahllokalsystem.wahlvorbereitungservice.configuration.nfcconverter" level="debug" />

        <!-- Logger usage -->
        <root level="info">
            <appender-ref ref="STDOUT" />
        </root>

    </springProfile>


    <springProfile name="!plainTextLogging">

        <!-- Log appender -->
        <appender name="JSON_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <providers>
                    <!-- provides the fields in the configured pattern -->
                    <pattern>
                        <!-- the pattern that defines what to include -->
                        <pattern>
                            {
                                "timestamp" : "%date{yyyy-MM-dd'T'HH:mm:ss.SSS}",
                                "appName" : "${springAppName}",
                                "user" : "%mdc{user}",
                                "TraceId" : "%mdc{traceId}",
                                "SpanId" : "%mdc{spanId}",
                                "X-Span-Export" : "%mdc{X-Span-Export}",
                                "thread" : "%thread",
                                "level" : "%level",
                                "logger": "%logger",
                                "location" : {
                                    "fileName" : "%file",
                                    "line" : "%line"
                                },
                                "message": "%message"
                            }
                        </pattern>
                    </pattern>
                    <stackTrace>
                        <fieldName>stacktrace</fieldName>
                    </stackTrace>
                </providers>
            </encoder>
        </appender>

        <!-- Logger: only set levels; appenders are configured on the root logger -->
        <logger name="de.muenchen.oss.wahllokalsystem.wahlvorbereitungservice" level="warn" />
        <logger name="de.muenchen.allgemein" level="warn" />
        <logger name="org.springframework.web" level="warn" />
        <!-- set to debug locally if needed to see authorities -->
        <logger name="de.muenchen.oss.wahllokalsystem.wahlvorbereitungservice.configuration.UserInfoAuthoritiesRetriever" level="warn" />
        <!-- sql and hibernate statistics -->
        <logger name="org.hibernate.SQL" level="warn" />
        <logger name="org.hibernate.engine.internal.StatisticalLoggingSessionEventListener" level="warn" />

        <!-- PathVars, URL & Parameter -->
        <logger name="org.springframework.web.servlet.DispatcherServlet" level="warn" />
        <!-- Methodennamen -->
        <logger name="org.springframework.web.servlet.mvc.method.annotation.RequestMappingHandlerMapping" level="info" />
        <!-- User, URL, Status -->
        <logger name="de.muenchen.oss.wahllokalsystem.wahlvorbereitungservice.security.RequestResponseLoggingFilter" level="info" />
        <!-- Specific NfcHelper Filter for Payload (specific loglevel can be set) -->
        <logger name="de.muenchen.oss.wahllokalsystem.wahlvorbereitungservice.configuration.nfcconverter.NfcHelper" level="warn" />
        <!-- Logger for other Nfc Logging-Data -->
        <logger name="de.muenchen.oss.wahllokalsystem.wahlvorbereitungservice.configuration.nfcconverter" level="warn" />

        <!-- Logger usage -->
        <root level="info">
            <appender-ref ref="JSON_STDOUT" />
        </root>

    </springProfile>


</configuration>
