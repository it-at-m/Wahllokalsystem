### POST wahlbezirkID
POST {{ WLS_WAHLVORBEREITUNG_SERVICE_URL }}/businessActions/briefwahlvorbereitung/wahlbezirkID
Authorization: Bearer {{$auth.token("auth-service")}}
Content-Type: application/json

{
  "urnenAnzahl": [
    {
      "anzahl": 1,
      "urneVersiegelt": true,
      "wahlID": "wahlID1"
    },
    {
      "wahlID": "wahlID2",
      "urneVersiegelt": false,
      "anzahl": 13
    }
  ]
}

