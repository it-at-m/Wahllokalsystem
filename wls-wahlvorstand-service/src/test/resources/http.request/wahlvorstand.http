### get userinfo with auth_token
GET {{ SSO_URL }}/auth/realms/wls_realm/protocol/openid-connect/userinfo
Authorization: {{ token_type }} {{ auth_token }}

### GET wahlvorstand - working with dummy.client
GET {{ WLS_WAHLVORSTAND_SERVICE_URL }}/businessActions/wahlvorstand/wahlbezirkID
Authorization: {{ token_type }} {{ auth_token }}

### POST wahlvorstand
POST {{ WLS_WAHLVORSTAND_SERVICE_URL }}/businessActions/wahlvorstand/wahlbezirkID
Authorization: {{ token_type }} {{ auth_token }}
Content-Type: application/json

{
  "wahlbezirkID": "wahlbezirkID",
  "anwesenheitBeginn": "2024-06-09T23:59:12.123",
  "wahlvorstandsmitglieder": [
    {
      "identifikator": "identifikator",
      "familienname": "name",
      "vorname": "vorname",
      "funktion": "SB",
      "funktionsname": "Name",
      "anwesend": true
    },
    {
      "identifikator": "identifikator2",
      "familienname": "name2",
      "vorname": "vorname2",
      "funktion": "SWB",
      "funktionsname": "anderer Name",
      "anwesend": false
    }
  ]
}
